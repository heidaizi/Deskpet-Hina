{
  "name": "deskpet",
  "version": "1.2.0",
  "private": true,
  "description": "A macOS desktop pet prototype for Hina (Swimsuit).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package:app": "npm run build && zsh scripts/package-macos-app.zsh",
    "signing:check": "zsh scripts/check-signing-identity.zsh",
    "assets:voices": "node scripts/fetch-official-voices.mjs",
    "tts:download-models": "node scripts/download-irodori-models.mjs",
    "tts:prepare-dataset": "node scripts/prepare-hina-tts-dataset.mjs",
    "tts:fetch-hina-expanded": "node scripts/fetch-hina-expanded-training.mjs",
    "tts:prepare-hina-expanded": "node scripts/prepare-hina-expanded-dataset.mjs",
    "tts:fetch-hina-multiform": "node scripts/fetch-hina-multiform-training.mjs",
    "tts:build-hina-app-eval": "node scripts/build-hina-app-tts-eval.mjs",
    "tts:summarize-hina-app-eval": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/summarize-hina-app-tts-eval.py",
    "tts:build-prebuilt": "node scripts/build-prebuilt-tts-manifest.mjs",
    "tts:prepare-hina-multiform": "node scripts/prepare-hina-multiform-dataset.mjs",
    "tts:balance-hina-multiform": "node scripts/balance-hina-multiform-manifest.mjs",
    "tts:build-hina-emotion-lora-manifest": "node scripts/build-hina-emotion-lora-manifest.mjs",
    "tts:audit-hina-multiform": "node scripts/audit-hina-multiform-taxonomy.mjs",
    "tts:reclassify-hina-multiform": "node scripts/reclassify-hina-multiform-catalog.mjs",
    "tts:audit-hina-audio": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/audit-hina-multiform-audio.py",
    "tts:audit-hina-noise": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/audit-hina-noise.py",
    "tts:denoise-hina-audio": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/denoise-hina-audio.py",
    "tts:evaluate-hina-emotion": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/evaluate-hina-emotion.py",
    "tts:score-hina-speaker": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/score-hina-speaker-similarity.py",
    "tts:classify-hina-emotion": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/classify-hina-emotion-results.py",
    "tts:classify-hina-emotion-wavlm": "~/.local/share/deskpet-tts/Irodori-TTS/.venv/bin/python scripts/classify-hina-emotion-wavlm.py",
    "tts:train-hina-multiform": "zsh scripts/train-hina-multiform.zsh",
    "tts:train-hina-emotion-lora": "zsh scripts/train-hina-emotion-lora.zsh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run typecheck && npm run format:check && npm test && npm run build",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "presence:replay": "esbuild scripts/replay-presence.ts --bundle --platform=node --format=esm --outfile=/tmp/deskpet-presence-replay.mjs && node /tmp/deskpet-presence-replay.mjs",
    "transfer:bundle": "zsh scripts/build-transfer-bundle.zsh",
    "acceptance:capture": "node scripts/capture-acceptance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:tts": "node scripts/bench-tts.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@pixiv/three-vrm": "^3.5.5",
    "electron": "^45.0.0",
    "pixi.js": "^8.22.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
